@page
@model Proyecto_Nuevo_Avatar_V2.Pages.Index.PrincipalModel
@{

    Layout = "_Layout";
    ViewData["Title"] = "Página Principal";

}

<link rel="stylesheet" href="~/css/Principal.css" />

<div class="container-fluid py-5">

    <!-- Header -->
    <div class="header text-center mb-5 p-5 rounded shadow">
        <h1 class="display-4 font-weight-bold mb-3 text-break" >
            <i class="fas fa-hand-sparkles mr-2"></i> ¡Bienvenido(a), @ViewData["Nombre"]! @ViewData["Rol"]
        </h1>
        <p class="lead">Este es tu panel principal, aquí podrás acceder a tus módulos y funcionalidades frecuentes.</p>
        <hr class="my-4 bg-light">
        <p class="mb-0">Haz clic en cualquier tarjeta para ingresar directamente a la sección deseada.</p>
    </div>

    
    <div class="row text-center">

        @if (ViewData["Rol"]?.ToString() == "ADM")
        {
            
        

        <!-- Admin -->
        <div class="col-lg-4 mb-4">
            <a href="/ADM_Usuarios/Index" class="card module-card shadow h-100 text-decoration-none text-dark">
                <div class="card-body">
                    <i class="fas fa-users fa-4x text-primary mb-3"></i>
                    <h5 class="font-weight-bold">Usuarios</h5>
                    <p class="text-muted">Gestiona los usuarios del sistema.</p>
                </div>
            </a>
        </div>

        <div class="col-lg-4 mb-4">
                <a href="/ADM9_Carreras/Index" class="card module-card shadow h-100 text-decoration-none text-dark">
                <div class="card-body">
                    <i class="fas fa-graduation-cap fa-4x text-success mb-3"></i>
                    <h5 class="font-weight-bold">Carreras</h5>
                    <p class="text-muted">Administra las carreras disponibles en el sistema.</p>
                </div>
            </a>
        </div>

        <div class="col-lg-4 mb-4">
                <a href="/ADM10_Cursos/Index" class="card module-card shadow h-100 text-decoration-none text-dark">
                <div class="card-body">
                    <i class="fas fa-book fa-4x text-info mb-3"></i>
                    <h5 class="font-weight-bold">Cursos</h5>
                    <p class="text-muted">Gestiona los cursos impartidos en los periodos activos.</p>
                </div>
            </a>
        </div>

        <div class="col-lg-4 mb-4">
                <a href="/ADM12_Periodos/Index" class="card module-card shadow h-100 text-decoration-none text-dark">
                <div class="card-body">
                    <i class="fas fa-calendar-alt fa-4x text-warning mb-3"></i>
                    <h5 class="font-weight-bold">Periodos Activos</h5>
                    <p class="text-muted">Consulta y gestiona los periodos académicos activos.</p>
                </div>
            </a>
        </div>

        <div class="col-lg-4 mb-4">
            <a href="/IPN1/Index" class="card module-card shadow h-100 text-decoration-none text-dark">
                <div class="card-body">
                    <i class="fas fa-file-invoice fa-4x text-danger mb-3"></i>
                    <h5 class="font-weight-bold">Facturas Pendientes</h5>
                    <p class="text-muted">Revisa y gestiona las facturas pendientes.</p>
                </div>
            </a>
        </div>

            <div class="col-lg-4 mb-4">
                <a href="/AyudaySoporte/Ayuda_Soporte" class="card module-card shadow h-100 text-decoration-none text-dark">
                    <div class="card-body">
                        <i class="fas fa-question-circle fa-4x text-info mb-3"></i>
                        <h5 class="font-weight-bold">Ayuda/Soporte</h5>
                        <p class="text-muted">Consulta la documentación y preguntas frecuentes y Contacta al equipo de soporte técnico para asistencia</p>
                    </div>
                </a>
            </div>

        }


        @if (ViewData["Rol"]?.ToString() == "PRF")
        {
            
        

        <!-- Profesor -->

        <div class="col-lg-4 mb-4">
            <a href="#" class="card module-card shadow h-100 text-decoration-none text-dark">
                <div class="card-body">
                    <i class="fas fa-users fa-4x text-primary mb-3"></i>
                    <h5 class="font-weight-bold">Mis Grupos</h5>
                    <p class="text-muted">Consulta los grupos que impartes en este periodo.</p>
                </div>
            </a>
        </div>

        <div class="col-lg-4 mb-4">
            <a href="#" class="card module-card shadow h-100 text-decoration-none text-dark">
                <div class="card-body">
                    <i class="fas fa-book fa-4x text-success mb-3"></i>
                    <h5 class="font-weight-bold">Cursos que Imparto</h5>
                    <p class="text-muted">Accede a los cursos asignados este periodo.</p>
                </div>
            </a>
        </div>

        <div class="col-lg-4 mb-4">
            <a href="#" class="card module-card shadow h-100 text-decoration-none text-dark">
                <div class="card-body">
                    <i class="fas fa-file-alt fa-4x text-info mb-3"></i>
                    <h5 class="font-weight-bold">Carga de Notas</h5>
                    <p class="text-muted">Accede a la carga de desglose y notas de tus cursos.</p>
                </div>
            </a>
        </div>

            <div class="col-lg-4 mb-4">
                <a href="/AyudaySoporte/Ayuda_Soporte" class="card module-card shadow h-100 text-decoration-none text-dark">
                    <div class="card-body">
                        <i class="fas fa-question-circle fa-4x text-info mb-3"></i>
                        <h5 class="font-weight-bold">Ayuda/Soporte</h5>
                        <p class="text-muted">Consulta la documentación y preguntas frecuentes y Contacta al equipo de soporte técnico para asistencia</p>
                    </div>
                </a>
            </div>

        }

    </div>


</div>
