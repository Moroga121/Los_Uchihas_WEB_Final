@page
@model Proyecto_Nuevo_Avatar_V2.Pages.ADM11_Profesores.IndexModel
@{
    ViewData["Title"] = "Gestión de Profesores";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
<link rel="stylesheet" href="~/css/ADM_Usuarios.css" />

<h2 class="text-center">Gestión de Profesores</h2>

<p>
    <a asp-page="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Crear nuevo Usuario
    </a>

</p>

<form method="get" id="filtroForm" class="mb-4">
    <div class="row g-3 align-items-center">
        <div class="col-md-2">
            <label for="Busqueda" class="form-label mb-1 fw-semibold">Buscar por nombre, email o identificación:</label>
            <input type="text" id="Busqueda" name="Busqueda" class="form-control"
                   value="@Model.Busqueda" placeholder="Ejemplo: Juan Pérez o jperez@cuc.ac.cr" />
        </div>
    </div>
    <div class="mt-3 text-end">

        <button type="submit" class="btn btn-success" id="btnBuscar">
            <i class="bi bi-search"></i> Buscar
        </button>

        <a asp-page="Index" class="btn btn-secondary">
            <i class="bi bi-eraser"></i> Limpiar
        </a>

    </div>
</form>

<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Tipo ID</th>
            <th>Identificación</th>
            <th>Nombre</th>
            <th>Email</th>
            <th>Fecha Nacimiento</th>
            <th>Teléfono</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Profesores != null && Model.Profesores.Any())
        {
            foreach (var profesor in Model.Profesores)
            {
                <tr>
                    <td data-label="" class="text-break">@profesor.ID_Profesor</td>
                    <td data-label="" class="text-break">@profesor.TipoIdentificacion</td>
                    <td data-label="" class="text-break">@profesor.NumeroIdentificacion</td>
                    <td data-label="" class="text-break">@profesor.Nombre</td>
                    <td data-label="" class="text-break">@profesor.Email</td>
                    <td data-label="" class="text-break">@profesor.FechaNacimiento.ToString("dd/MM/yyyy")</td>
                    <td data-label="" class="text-break">@profesor.Telefono</td>
                    <td>
                        <a asp-page="Edit" asp-route-id="@profesor.ID_Profesor" class="btn btn-warning btn-sm">
                            <i class="bi bi-pencil-square"></i> Editar
                        </a>
                        <button type="button"
                                class="btn btn-danger btn-sm"
                                data-bs-toggle="modal"
                                data-bs-target="#confirmDeleteModal"
                                data-id="@profesor.ID_Profesor"
                                data-nombre="@profesor.Nombre">
                            <i class="bi bi-trash3"></i> Eliminar
                        </button>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr><td colspan="8" class="text-center">No hay profesores registrados.</td></tr>
        }
    </tbody>
</table>

@if (Model.TotalPaginas > 1)
{
    <div id="paginacion" class="my-3 d-flex justify-content-center">
        <nav aria-label="Paginación de parámetros">
            <ul class="pagination pagination-sm mb-0">
                <!-- Botón Página Anterior -->
                @if (Model.PaginaActual > 1)
                {
                    <li class="page-item">
                        <a class="page-link" href="?numeroPagina=@(Model.PaginaActual - 1)" aria-label="Anterior">
                            <span aria-hidden="true">&laquo;</span>
                        </a>
                    </li>
                }

                <!-- Números de Página -->
                @for (int i = 1; i <= Model.TotalPaginas; i++)
                {
                    <li class="page-item @(i == Model.PaginaActual ? "active" : "")">
                        <a class="page-link" href="?numeroPagina=@i">@i</a>
                    </li>
                }

                <!-- Botón Página Siguiente -->
                @if (Model.PaginaActual < Model.TotalPaginas)
                {
                    <li class="page-item">
                        <a class="page-link" href="?numeroPagina=@(Model.PaginaActual + 1)" aria-label="Siguiente">
                            <span aria-hidden="true">&raquo;</span>
                        </a>
                    </li>
                }
            </ul>
        </nav>
    </div>
}

<!-- Modal resultado -->
<div class="modal fade" id="resultModal" tabindex="-1" aria-labelledby="resultModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" id="resultModalHeader">
                <h5 class="modal-title" id="resultModalLabel">Resultado</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body" id="resultModalBody">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal confirmación eliminación -->
<div class="modal fade" id="confirmDeleteModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">Confirmar eliminación</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                ¿Seguro que deseas eliminar al profesor <strong id="profesorNombre"></strong>?
            </div>
            <div class="modal-footer">
                <form method="post" asp-page-handler="Delete">
                    <input type="hidden" id="profesorIdEliminar" name="id" />
                    <button type="submit" class="btn btn-danger">Sí, eliminar</button>
                </form>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const mensaje = "@Html.Raw(TempData["Resultado"])";
            const tipo = "@TempData["TipoMensaje"]";


            if (mensaje && mensaje.trim() !== "") {
                const modal = new bootstrap.Modal(document.getElementById("resultModal"));
                document.getElementById("resultModalBody").textContent = mensaje;
                const title = document.getElementById("resultModalLabel");

                title.textContent = (tipo === "exito") ? "Éxito" : "Error";

                if (tipo === "exito") {
                    resultModalHeader.className = "modal-header bg-success text-white";
                } else {
                    resultModalHeader.className = "modal-header bg-danger text-white";
                }

                modal.show();
            }

            const confirmDeleteModal = document.getElementById('confirmDeleteModal');
            confirmDeleteModal.addEventListener('show.bs.modal', function (event) {
                const button = event.relatedTarget;
                document.getElementById('profesorIdEliminar').value = button.getAttribute('data-id');
                document.getElementById('profesorNombre').innerText = button.getAttribute('data-nombre');
            });
        });
    </script>
}

