@page
@model Proyecto_Nuevo_Avatar_V2.Pages.IPN3.CreateModel
@{
    Response.ContentType = "text/html; charset=utf-8";
    Layout = "_Layout";
}

<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
<link rel="stylesheet" href="~/css/ADM_Usuarios.css" />

<h2 class="text-center">
    <i class="fas fa-plus-circle"></i> Crear Nueva Notificación
</h2>

<div class="card shadow p-4">
    <form method="post" id="formNotificacion">

        <div class="form-group mb-3">
            <label for="Notificacion_Email" class="form-label">Correo(s) Destinatario</label>
            <input asp-for="Notificacion.Email" class="form-control" placeholder="usuario@cuc.cr" />
            <span asp-validation-for="Notificacion.Email" class="text-danger"></span>
            <small class="text-muted">Separa múltiples correos con (; o ,)</small>
        </div>

        <div class="form-group mb-3">
            <label for="Notificacion_Asunto" class="form-label">Asunto</label>
            <input asp-for="Notificacion.Asunto" class="form-control" placeholder="Ingrese el asunto" />
            <span asp-validation-for="Notificacion.Asunto" class="text-danger"></span>
        </div>

        <div class="form-group mb-3">
            <label for="Notificacion_Cuerpo" class="form-label">Cuerpo del Correo</label>
            <textarea asp-for="Notificacion.Cuerpo" class="form-control" rows="5" placeholder="Ingrese el contenido"></textarea>
            <span asp-validation-for="Notificacion.Cuerpo" class="text-danger"></span>
        </div>

        <div class="text-center">
            <button type="button" id="btnMostrarConfirmacion" class="btn btn-success">
                <i class="fas fa-paper-plane"></i> Enviar Notificación
            </button>
            <a asp-page="Index" class="btn btn-secondary">
                <i class="bi bi-arrow-left-circle"></i> Volver
            </a>
        </div>
    </form>
</div>

<!-- Modal de CONFIRMACIÓN -->
<div class="modal fade" id="confirmModal" tabindex="-1" aria-labelledby="confirmModalLabel" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-warning text-dark">
                <h5 class="modal-title" id="confirmModalLabel">
                    <i class="fas fa-exclamation-triangle"></i> Confirmación de Envío
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <p class="mb-0">¿Está seguro que desea enviar esta notificación?</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times"></i> Cancelar
                </button>
                <button type="button" id="btnConfirmarEnvio" class="btn btn-success">
                    <i class="fas fa-check"></i> Confirmar
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal de resultados -->
<div class="modal fade" id="resultModal" tabindex="-1" aria-labelledby="resultModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-success text-white" id="resultModalHeader">
                <h5 class="modal-title" id="resultModalLabel">Resultado</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body" id="resultModalBody">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const form = document.getElementById('formNotificacion');
            const btnMostrarConfirmacion = document.getElementById('btnMostrarConfirmacion');
            const btnConfirmarEnvio = document.getElementById('btnConfirmarEnvio');
            const confirmModal = new bootstrap.Modal(document.getElementById('confirmModal'));

            btnMostrarConfirmacion.addEventListener('click', function(e) {
                e.preventDefault();

                if (form.checkValidity()) {
                    confirmModal.show();
                } else {
                    form.reportValidity();
                }
            });

            btnConfirmarEnvio.addEventListener('click', function() {
                confirmModal.hide();
                form.submit();
            });

            const mensaje = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["Resultado"]));
            const tipo = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["TipoMensaje"]));

            if (mensaje && mensaje.trim() !== "") {
                const resultModalBody = document.getElementById("resultModalBody");
                const resultModalTitle = document.getElementById("resultModalLabel");
                const resultModalHeader = document.getElementById("resultModalHeader");
                const resultModal = new bootstrap.Modal(document.getElementById("resultModal"));

                if (tipo === "exito") {
                    resultModalTitle.textContent = "Éxito";
                    resultModalHeader.className = "modal-header bg-success text-white";
                } else {
                    resultModalTitle.textContent = "Error";
                    resultModalHeader.className = "modal-header bg-danger text-white";
                }

                resultModalBody.textContent = mensaje;
                resultModal.show();

                document.getElementById("resultModal").addEventListener('hidden.bs.modal', function () {
                    if (tipo === "exito") {
                        window.location.href = "/IPN3/Index";
                    }
                });
            }
        });
    </script>
}
