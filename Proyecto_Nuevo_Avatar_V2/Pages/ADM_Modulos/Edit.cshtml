@page "{id}"
@model Proyecto_Nuevo_Avatar_V2.Pages.ADM_Modulos.EditModel
@{
    ViewData["Title"] = "Editar Módulo";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
<link rel="stylesheet" href="~/css/ADM_Usuarios.css" />


<h2 class="text-center">
    <i class="bi bi-pencil-square"></i> Editar Módulo
</h2>

<div class="card shadow p-4">
    <form method="post">
        <div class="form-group mb-3">
            <label for="Identificador_Modulo" class="form-label">Identificador del Módulo</label>
            <input asp-for="ModuloEditado.Identificador_Modulo" class="form-control" readonly />
            <span asp-validation-for="ModuloEditado.Identificador_Modulo" class="text-danger"></span>
        </div>

        <div class="form-group mb-3">
            <label for="Nombre_Modulo" class="form-label">Nombre del Módulo</label>
            <input asp-for="ModuloEditado.Nombre_Modulo" class="form-control" placeholder="Ejemplo: Gestión de Usuarios" />
            <span asp-validation-for="ModuloEditado.Nombre_Modulo" class="text-danger"></span>
        </div>

        <div class="form-group mb-3">
            <label for="Estado" class="form-label">Estado</label>
            <select asp-for="ModuloEditado.Estado" asp-items="Model.Estados" class="form-select">
                <option value="">-- Seleccione --</option>
            </select>
            <span asp-validation-for="ModuloEditado.Estado" class="text-danger"></span>
        </div>


        <div class="form-group mb-3">
            <label for="Orden" class="form-label">Orden</label>
            <input asp-for="ModuloEditado.Orden" type="number" class="form-control" min="1" />
            <span asp-validation-for="ModuloEditado.Orden" class="text-danger"></span>
        </div>

        <div class="text-center">
            <button type="submit" class="btn btn-warning">
                <i class="bi bi-save"></i> Actualizar
            </button>
            <a asp-page="Index" class="btn btn-secondary">
                <i class="bi bi-arrow-left-circle"></i> Volver
            </a>
        </div>
    </form>
</div>

<!-- Modal de resultados (igual que en Create) -->
<div class="modal fade" id="resultModal" tabindex="-1" aria-labelledby="resultModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" id="resultModalHeader">
                <h5 class="modal-title" id="resultModalLabel">Resultado</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body" id="resultModalBody">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const mensaje = "@TempData["Resultado"]";
            const tipo = "@TempData["TipoMensaje"]";
            const redireccion = "@TempData["Redireccion"]";

            if (mensaje && mensaje.trim() !== "") {
                const resultModalBody = document.getElementById("resultModalBody");
                const resultModalTitle = document.getElementById("resultModalLabel");
                const resultModal = new bootstrap.Modal(document.getElementById("resultModal"));

                    resultModalTitle.textContent = (tipo === "exito") ? "Éxito" : "Error";

                    if (tipo === "exito") {
                        resultModalHeader.className = "modal-header bg-success text-white";
                    } else {
                        resultModalHeader.className = "modal-header bg-danger text-white";
                    }

                resultModalBody.textContent = mensaje;
                resultModal.show();

                document.getElementById("resultModal").addEventListener('hidden.bs.modal', function () {
                    if (tipo === "exito" && redireccion) {
                        window.location.href = `/ADM_Modulos/${redireccion}`;
                    }
                });
            }
        });
    </script>
}
