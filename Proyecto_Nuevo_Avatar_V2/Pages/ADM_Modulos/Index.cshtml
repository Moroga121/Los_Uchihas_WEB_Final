@page
@model Proyecto_Nuevo_Avatar_V2.Pages.ADM_Modulos.IndexModel
@{
    ViewData["Title"] = "Módulos";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
<link rel="stylesheet" href="~/css/ADM_Usuarios.css" />


<style>
    table input[type="checkbox"] {
        margin: 0 auto;   /* Centra horizontalmente */
        display: block;   /* Evita que floten */
    }
</style>
<h2 class="text-center">Gestión de Módulos</h2>

<p>

    <a asp-page="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Crear nuevo Módulo
    </a>

</p>

<!-- Tabla de módulos con scroll -->
<div class="table-responsive" style="max-height: 400px; overflow-y: auto;">
    <table class="table table-bordered table-striped align-middle">
        <thead class="table-dark text-center">
            <tr>
                <th>ID</th>
                <th>Nombre</th>
                <th>Estado</th>
                <th>Orden</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Modulos != null && Model.Modulos.Any())
            {
                foreach (var modulo in Model.Modulos)
                {
                    <tr>
                        <td>@modulo.Identificador_Modulo</td>
                        <td data-label="" class="text-break">@modulo.Nombre_Modulo</td>
                        <td>
                            @if (modulo.Estado == "Activo")
                            {
                                <span class="badge bg-success">Activo</span>
                            }
                            else
                            {
                                <span class="badge bg-false">Inactivo</span>
                            }
                        </td>
                        <td>@modulo.Orden</td>
                        <td class="text-center">
                            <a asp-page="Edit" asp-route-id="@modulo.Identificador_Modulo" class="btn btn-warning btn-sm"><i class="bi bi-pencil-square"></i> Editar</a>

                            <button type="button"
                                    class="btn btn-danger btn-sm"
                                    data-bs-toggle="modal"
                                    data-bs-target="#confirmDeleteModal"
                                    data-id="@modulo.Identificador_Modulo"
                                    data-nombre="@modulo.Nombre_Modulo">
                                <i class="bi bi-trash3"></i> Eliminar
                            </button>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="5" class="text-center">No hay módulos registrados.</td>
                </tr>
            }
        </tbody>
    </table>

</div>

<!--Tabla para asignación de permisos-->
<h2 class="text-center mt-5">Matriz de Permisos por Rol</h2>

<form method="post" asp-page-handler="ActualizarPermisos">
    <input type="hidden" name="moduloId" id="moduloIdHidden" />

    <!-- Tabla de permisos con scroll -->
    <div class="table-responsive" style="max-height: 500px; overflow-y: auto;">
        <table class="table table-bordered table-hover text-center align-middle mt-3">
            <thead class="table-dark">
                <tr>
                    <th>Modulo</th>
                    @foreach (var rol in Model.Roles)
                    {
                        <th>@rol.Nombre_Rol</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var modulo in Model.Modulos)
                {
                    <tr>
                        <td data-label="" class="text-break">
                            <strong>@modulo.Nombre_Modulo</strong><br />
                            <button type="button" class="btn btn-sm btn-primary mt-1"
                                    onclick="guardarPermisos('@modulo.Identificador_Modulo')">
                                Guardar
                            </button>
                        </td>
                        @foreach (var rol in Model.Roles)
                        {
                            var asignado = Model.RolModulo.Any(r =>
                            r.Identificador_Rol == rol.Identificador_Rol &&
                            r.Identificador_Modulo == modulo.Identificador_Modulo);

                            <td class="text-center align-middle">
                                <input type="checkbox"
                                       name="rolesSeleccionados"
                                       value="@rol.Identificador_Rol"
                                       data-modulo="@modulo.Identificador_Modulo"
                                       @(asignado ? "checked" : "") />
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
</form>

<script>
    function guardarPermisos(moduloId) {
        document.getElementById("moduloIdHidden").value = moduloId;

        const allCheckboxes = document.querySelectorAll("input[type='checkbox'][name='rolesSeleccionados']");
        allCheckboxes.forEach(chk => {
            if (chk.dataset.modulo !== moduloId) {
                chk.disabled = true;
            }
        });

        document.querySelector("form").submit();

        setTimeout(() => {
            allCheckboxes.forEach(chk => chk.disabled = false);
        }, 500);
    }
</script>

<!-- Modal de confirmación de eliminación -->
<div class="modal fade" id="confirmDeleteModal" tabindex="-1" aria-labelledby="confirmDeleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="confirmDeleteModalLabel">Confirmar eliminación</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                ¿Seguro que deseas eliminar el módulo <strong id="moduloNombre"></strong>?
            </div>
            <div class="modal-footer">
                <form method="post" asp-page-handler="Delete" id="deleteForm">
                    <input type="hidden" name="id" id="moduloIdEliminar" />
                    <button type="submit" class="btn btn-danger">Sí, eliminar</button>
                </form>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal de resultado -->
<div class="modal fade" id="resultModal" tabindex="-1" aria-labelledby="resultModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" id="resultModalHeader">
                <h5 class="modal-title" id="resultModalLabel">Resultado</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body" id="resultModalBody">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const mensaje = "@TempData["Resultado"]";
            const tipo = "@TempData["TipoMensaje"]";

            if (mensaje && mensaje.trim() !== "") {
                const resultModalBody = document.getElementById("resultModalBody");
                const resultModalTitle = document.getElementById("resultModalLabel");

                resultModalTitle.textContent = (tipo === "exito") ? "Éxito" : "Error";

                    if (tipo === "exito") {
                        resultModalHeader.className = "modal-header bg-success text-white";
                    } else {
                        resultModalHeader.className = "modal-header bg-danger text-white";
                    }

                if (tipo === "exito") {
                    resultModalTitle.textContent = "Éxito";
                    resultModalBody.textContent = mensaje;
                } else {
                    resultModalTitle.textContent = "Error";
                    resultModalBody.textContent = mensaje;
                }

                const modal = new bootstrap.Modal(document.getElementById("resultModal"));
                modal.show();
            }
        });

        // Configurar modal de eliminación
        const confirmDeleteModal = document.getElementById('confirmDeleteModal');
        confirmDeleteModal.addEventListener('show.bs.modal', function (event) {
            const button = event.relatedTarget;
            const idModulo = button.getAttribute('data-id');
            const nombreModulo = button.getAttribute('data-nombre');

            document.getElementById('moduloIdEliminar').value = idModulo;
            document.getElementById('moduloNombre').innerText = nombreModulo;
        });
    </script>
}
