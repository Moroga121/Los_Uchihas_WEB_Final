@page "/ADM13_Grupos/Create"
@model Proyecto_Nuevo_Avatar_V2.Pages.ADM13_Grupos.CreateModel

@{
    ViewData["Title"] = "Crear Grupo";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
<link rel="stylesheet" href="~/css/ADM_Usuarios.css" />

<h2 class="text-center">
    <i class="bi bi-plus-circle"></i> Crear nuevo grupo
</h2>

<div class="card shadow p-4">
    <form method="post">
        <div class="form-group mb-3">
            <label class="form-label">ID Grupo</label>
            <input asp-for="NuevoGrupo.ID_Grupo" class="form-control" placeholder="Ejemplo: GRP001" />
            <span asp-validation-for="NuevoGrupo.ID_Grupo" class="text-danger"></span>
        </div>

        <div class="form-group mb-3">
            <label class="form-label">Número de Grupo</label>
            <input asp-for="NuevoGrupo.Numero_Grupo" type="number" class="form-control" min="1" placeholder="Ejemplo: 1" />
            <span asp-validation-for="NuevoGrupo.Numero_Grupo" class="text-danger"></span>
        </div>

        <div class="form-group mb-3">
            <label class="form-label">Curso</label>
            <select asp-for="NuevoGrupo.ID_Curso" class="form-control">
                <option value="">-- Seleccione un curso --</option>
                @foreach (var curso in Model.Cursos)
                {
                    <option value="@curso.ID_Curso">@curso.Nombre</option>
                }
            </select>
            <span asp-validation-for="NuevoGrupo.ID_Curso" class="text-danger"></span>
        </div>

        <div class="form-group mb-3">
            <label class="form-label">Profesor</label>
            <select asp-for="NuevoGrupo.ID_Profesor" class="form-control">
                <option value="">-- Seleccione un profesor --</option>
                @foreach (var profesor in Model.Profesores)
                {
                    <option value="@profesor.ID_Profesor">@profesor.Nombre</option>
                }
            </select>
            <span asp-validation-for="NuevoGrupo.ID_Profesor" class="text-danger"></span>
        </div>

        <div class="form-group mb-3">
            <label class="form-label">Horario</label>
            <input asp-for="NuevoGrupo.Horario" class="form-control" placeholder="Ejemplo: Lunes 8:00 - 10:00" />
            <span asp-validation-for="NuevoGrupo.Horario" class="text-danger"></span>
        </div>

        <div class="form-group mb-3">
            <label class="form-label">Periodo</label>
            <select asp-for="NuevoGrupo.ID_Periodo" class="form-control">
                <option value="">-- Seleccione un periodo --</option>
                @foreach (var periodo in Model.Periodos)
                {
                    <option value="@periodo.ID_Periodo">@periodo.ID_Periodo</option>
                }
            </select>
            <span asp-validation-for="NuevoGrupo.ID_Periodo" class="text-danger"></span>
        </div>

        <div class="text-center">
            <button type="submit" class="btn btn-success">
                <i class="bi bi-save"></i> Guardar
            </button>
            <a asp-page="Index" class="btn btn-secondary">
                <i class="bi bi-arrow-left-circle"></i> Volver
            </a>
        </div>
    </form>
</div>

<!-- Modal resultado -->
<div class="modal fade" id="resultModal" tabindex="-1" aria-labelledby="resultModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" id="resultModalHeader">
                <h5 class="modal-title" id="resultModalLabel">Resultado</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body" id="resultModalBody">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const mensaje = "@Html.Raw(TempData["Resultado"])";
            const tipo = "@TempData["TipoMensaje"]";
            const redireccion = "@TempData["Redireccion"]";

            if (mensaje && mensaje.trim() !== "") {
                const modal = new bootstrap.Modal(document.getElementById("resultModal"));
                document.getElementById("resultModalBody").textContent = mensaje;
                const title = document.getElementById("resultModalLabel");

                    title.textContent = (tipo === "exito") ? "Éxito" : "Error";

                    if (tipo === "exito") {
                        resultModalHeader.className = "modal-header bg-success text-white";
                    } else {
                        resultModalHeader.className = "modal-header bg-danger text-white";
                    }

                modal.show();

                document.getElementById("resultModal").addEventListener("hidden.bs.modal", function () {
                    if (tipo === "exito" && redireccion) {
                        window.location.href = `/ADM13_Grupos/${redireccion}`;
                    }
                });
            }
        });
    </script>
}

