@page
@model Proyecto_Nuevo_Avatar_V2.Pages.ADM_Expedientes.IndexModel
@{
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
<link rel="stylesheet" href="~/css/ADM_Usuarios.css" />

<h2 class="text-center">Gestión de Expedientes</h2>

<p>
    <a asp-page="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Crear nuevo Expediente
    </a>
</p>

<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>Número Identificación</th>
            <th>Tipo</th>
            <th>Nombre</th>
            <th>Email</th>
            <th>Teléfono</th>
            <th>Distrito</th>
            <th>Fecha Nacimiento</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Expedientes != null && Model.Expedientes.Any())
        {
            foreach (var expediente in Model.Expedientes)
            {
                <tr>
                    <td>@expediente.numero_identificacion</td>
                    <td>@expediente.tipo_identificacion</td>
                    <td class="text-break">@expediente.nombre</td>
                    <td class="text-break">@expediente.email</td>
                    <td>@expediente.telefono</td>
                    <td>@expediente.id_distrito</td>
                    <td>@expediente.fecha_nacimiento</td>
                    <td>
                        <a asp-page="Edit"
                           asp-route-id="@expediente.numero_identificacion"
                           class="btn btn-warning btn-sm">
                            <i class="bi bi-pencil-square"></i> Editar
                        </a>

                        <button type="button"
                                class="btn btn-danger btn-sm"
                                data-bs-toggle="modal"
                                data-bs-target="#confirmDeleteModal"
                                data-id="@expediente.numero_identificacion"
                                data-nombre="@expediente.nombre">
                            <i class="bi bi-trash3"></i> Eliminar
                        </button>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="7" class="text-center">No hay expedientes registrados.</td>
            </tr>
        }
    </tbody>
</table>

@if (Model.TotalPaginas > 1)
{
    <div id="paginacion" class="my-3 d-flex justify-content-center">
        <nav aria-label="Paginación de expedientes">
            <ul class="pagination pagination-sm mb-0">
                @if (Model.PaginaActual > 1)
                {
                    <li class="page-item">
                        <a class="page-link" href="?numeroPagina=@(Model.PaginaActual - 1)">
                            &laquo;
                        </a>
                    </li>
                }

                @for (int i = 1; i <= Model.TotalPaginas; i++)
                {
                    <li class="page-item @(i == Model.PaginaActual ? "active" : "")">
                        <a class="page-link" href="?numeroPagina=@i">@i</a>
                    </li>
                }

                @if (Model.PaginaActual < Model.TotalPaginas)
                {
                    <li class="page-item">
                        <a class="page-link" href="?numeroPagina=@(Model.PaginaActual + 1)">
                            &raquo;
                        </a>
                    </li>
                }
            </ul>
        </nav>
    </div>
}

<!-- Modal Resultado -->
<div class="modal fade" id="resultModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" id="resultModalHeader">
                <h5 class="modal-title" id="resultModalLabel">Resultado</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="resultModalBody"></div>
            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Confirmar Eliminación -->
<div class="modal fade" id="confirmDeleteModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">Confirmar eliminación</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                ¿Seguro que deseas eliminar el expediente <strong id="ExpedienteNombre"></strong>?
            </div>
            <div class="modal-footer">
                <form method="post" asp-page-handler="Delete">
                    <input type="hidden" name="id" id="ExpedienteIdEliminar" />
                    <button type="submit" class="btn btn-danger">Sí, eliminar</button>
                </form>
                <button class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>


    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const mensaje = @Html.Raw(Json.Serialize(TempData["Resultado"] ?? ""));
            const tipo = "@(TempData["TipoMensaje"] ?? "")";

            if (mensaje && mensaje.toString().trim() !== "") {
                const modalBody = document.getElementById("resultModalBody");
                const modalHeader = document.getElementById("resultModalHeader");
                const modalTitle = document.getElementById("resultModalLabel");

                modalTitle.textContent = tipo === "exito" ? "Éxito" : "Error";

                modalHeader.className =
                    tipo === "exito"
                        ? "modal-header bg-success text-white"
                        : "modal-header bg-danger text-white";

                modalBody.textContent = mensaje;

                const modal = new bootstrap.Modal(document.getElementById("resultModal"));
                modal.show();
            }
        });
    </script>



    <script>
        (function () {
            const modal = document.getElementById('confirmDeleteModal');
            modal.addEventListener('show.bs.modal', function (event) {
                const button = event.relatedTarget;
                document.getElementById('ExpedienteIdEliminar').value =
                    button.getAttribute('data-id');
                document.getElementById('ExpedienteNombre').innerText =
                    button.getAttribute('data-nombre');
            });
        })();
    </script>
}