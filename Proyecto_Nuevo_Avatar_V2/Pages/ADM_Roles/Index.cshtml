@page
@model Proyecto_Nuevo_Avatar_V2.Pages.ADM_Roles.IndexModel
@{
    ViewData["Title"] = "Roles";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
<link rel="stylesheet" href="~/css/ADM_Usuarios.css" />

<h2 class="text-center">Gestión de Roles</h2>

<p>
    <a asp-page="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Crear nuevo Rol
    </a>
</p>

<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Nombre del Rol</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Roles != null && Model.Roles.Any())
        {
            foreach (var rol in Model.Roles)
            {
                <tr>
                    <td data-label="" class="text-break">@rol.Identificador_Rol</td>
                    <td data-label="" class="text-break">@rol.Nombre_Rol</td>
                    <td>
                        <a asp-page="Edit" asp-route-id="@rol.Identificador_Rol" class="btn btn-warning btn-sm">
                            <i class="bi bi-pencil-square"></i> Editar
                        </a>
                        <button type="button"
                                class="btn btn-danger btn-sm"
                                data-bs-toggle="modal"
                                data-bs-target="#confirmDeleteModal"
                                data-id="@rol.Identificador_Rol"
                                data-nombre="@rol.Nombre_Rol">
                            <i class="bi bi-trash3"></i> Eliminar
                        </button>

                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="3" class="text-center">No hay roles registrados.</td>
            </tr>
        }
    </tbody>
</table>

@if (Model.TotalPaginas > 1)
{
    <div id="paginacion" class="my-3 d-flex justify-content-center">
        <nav aria-label="Paginación de parámetros">
            <ul class="pagination pagination-sm mb-0">
                <!-- Botón Página Anterior -->
                @if (Model.PaginaActual > 1)
                {
                    <li class="page-item">
                        <a class="page-link" href="?numeroPagina=@(Model.PaginaActual - 1)" aria-label="Anterior">
                            <span aria-hidden="true">&laquo;</span>
                        </a>
                    </li>
                }

                <!-- Números de Página -->
                @for (int i = 1; i <= Model.TotalPaginas; i++)
                {
                    <li class="page-item @(i == Model.PaginaActual ? "active" : "")">
                        <a class="page-link" href="?numeroPagina=@i">@i</a>
                    </li>
                }

                <!-- Botón Página Siguiente -->
                @if (Model.PaginaActual < Model.TotalPaginas)
                {
                    <li class="page-item">
                        <a class="page-link" href="?numeroPagina=@(Model.PaginaActual + 1)" aria-label="Siguiente">
                            <span aria-hidden="true">&raquo;</span>
                        </a>
                    </li>
                }
            </ul>
        </nav>
    </div>
}


<!--Tabla para asignación de permisos-->
<h2 class="text-center">Matriz de Permisos por Rol</h2>

<form method="post" asp-page-handler="ActualizarPermisos">
    <input type="hidden" name="rolId" id="rolIdHidden" />

    <!-- Tabla de permisos con scroll -->
    <div class="table-responsive" style="max-height: 500px; overflow-y: auto;">
        <table class="table table-bordered table-hover text-center align-middle mt-3">
            <thead class="table-dark">
                <tr>
                    <th>Rol</th>
                    @foreach (var modulo in Model.Modulos)
                    {
                        <th>@modulo.Nombre_Modulo</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var rol in Model.Roles)
                {
                    <tr>
                        <td data-label="" class="text-break">
                            <strong>@rol.Nombre_Rol</strong><br />
                            <button type="button" class="btn btn-sm btn-primary mt-1"
                                    onclick="guardarPermisos('@rol.Identificador_Rol')">
                                Guardar
                            </button>
                        </td>
                        @foreach (var modulo in Model.Modulos)
                        {
                            var asignado = Model.RolModulo.Any(r =>
                            r.Identificador_Rol == rol.Identificador_Rol &&
                            r.Identificador_Modulo == modulo.Identificador_Modulo);

                            <td class="text-center align-middle">
                                <input type="checkbox"
                                       name="modulosSeleccionados"
                                       value="@modulo.Identificador_Modulo"
                                       data-rol="@rol.Identificador_Rol"
                                       @(asignado ? "checked" : "") />
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
</form>

<script>
    function guardarPermisos(rolId) {
        document.getElementById("rolIdHidden").value = rolId;

        const allCheckboxes = document.querySelectorAll("input[type='checkbox'][name='modulosSeleccionados']");
        allCheckboxes.forEach(chk => {
            if (chk.dataset.rol !== rolId) {
                chk.disabled = true;
            }
        });

        document.querySelector("form").submit();

        setTimeout(() => {
            allCheckboxes.forEach(chk => chk.disabled = false);
        }, 500);
    }
</script>


<!--Modal de resultados -->
<div class="modal fade" id="resultModal" tabindex="-1" aria-labelledby="resultModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" id="resultModalHeader">
                <h5 class="modal-title" id="resultModalLabel">Resultado</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body" id="resultModalBody">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

<!--Modal de confirmación de eliminación -->
<div class="modal fade" id="confirmDeleteModal" tabindex="-1" aria-labelledby="confirmDeleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="confirmDeleteModalLabel">Confirmar eliminación</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                ¿Seguro que deseas eliminar el rol <strong id="rolNombre"></strong>?
            </div>
            <div class="modal-footer">
                <form method="post" asp-page-handler="Delete" id="deleteForm">
                    <input type="hidden" name="id" id="rolIdEliminar" />
                    <button type="submit" class="btn btn-danger">Sí, eliminar</button>
                </form>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const mensaje = "@TempData["Resultado"]";
            const tipo = "@TempData["TipoMensaje"]";

            if (mensaje && mensaje.trim() !== "") {
                const resultModalBody = document.getElementById("resultModalBody");
                const resultModalTitle = document.getElementById("resultModalLabel");

                    resultModalTitle.textContent = (tipo === "exito") ? "Éxito" : "Error";

                    if (tipo === "exito") {
                        resultModalHeader.className = "modal-header bg-success text-white";
                    } else {
                        resultModalHeader.className = "modal-header bg-danger text-white";
                    }

                if (tipo === "exito") {
                    resultModalTitle.textContent = "Éxito";
                    resultModalBody.textContent = mensaje;
                } else {
                    resultModalTitle.textContent = "Error";
                    resultModalBody.textContent = mensaje;
                }

                const modal = new bootstrap.Modal(document.getElementById("resultModal"));
                modal.show();
            }
        });

        // Configurar datos dinámicos para el modal de confirmación
        const confirmDeleteModal = document.getElementById('confirmDeleteModal');
        confirmDeleteModal.addEventListener('show.bs.modal', function (event) {
            const button = event.relatedTarget;
            const idRol = button.getAttribute('data-id');
            const nombreRol = button.getAttribute('data-nombre');

            document.getElementById('rolIdEliminar').value = idRol;
            document.getElementById('rolNombre').innerText = nombreRol;
        });
    </script>
    <script>
        const checkboxes = document.querySelectorAll('input[name="modulosSeleccionados"]');
        checkboxes.forEach(chk => {
            chk.addEventListener('change', function() {
                const row = this.closest('tr');
                const rolId = row.querySelector('td strong').textContent;
                document.getElementById('rolIdHidden').value = rolId;
            });
        });
    </script>
}

