@page "/ADM12_Periodos/Edit/{id}"
@model Proyecto_Nuevo_Avatar_V2.Pages.ADM12_Periodos.EditModel

@{
    ViewData["Title"] = "Editar Período";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
<link rel="stylesheet" href="~/css/ADM_Usuarios.css" />

<h2 class="text-center">
    <i class="bi bi-pencil-square"></i> Editar período académico
</h2>

<div class="card shadow p-4">
    <form method="post" novalidate>
        <div class="form-group mb-3">
            <label class="form-label">ID del período</label>
            <input asp-for="PeriodoEditado.ID_Periodo" class="form-control" readonly />
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">Año</label>
                <input asp-for="PeriodoEditado.Año" class="form-control" type="number" />
                <span asp-validation-for="PeriodoEditado.Año" class="text-danger"></span>
            </div>

            <div class="col-md-6 mb-3">
                <label class="form-label">Número de período</label>
                <input asp-for="PeriodoEditado.Numero_Periodo" class="form-control" type="number" placeholder="1 - 4" />
                <span asp-validation-for="PeriodoEditado.Numero_Periodo" class="text-danger"></span>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">Fecha de inicio</label>
                <input asp-for="PeriodoEditado.Fecha_Inicio" class="form-control" type="date" />
                <span asp-validation-for="PeriodoEditado.Fecha_Inicio" class="text-danger"></span>
            </div>

            <div class="col-md-6 mb-3">
                <label class="form-label">Fecha de fin</label>
                <input asp-for="PeriodoEditado.Fecha_Fin" class="form-control" type="date" />
                <span asp-validation-for="PeriodoEditado.Fecha_Fin" class="text-danger"></span>
            </div>
        </div>

        <div class="text-center">
            <button type="submit" class="btn btn-warning">
                <i class="bi bi-save"></i> Actualizar
            </button>
            <a asp-page="Index" class="btn btn-secondary">
                <i class="bi bi-arrow-left-circle"></i> Volver
            </a>

        </div>
    </form>
</div>

<!-- Modal de resultado -->
<div class="modal fade" id="resultModal" tabindex="-1" aria-labelledby="resultModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" id="resultModalHeader">
                <h5 class="modal-title" id="resultModalLabel">Resultado</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body" id="resultModalBody">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const mensaje = "@Html.Raw(TempData["Resultado"])";
            const tipo = "@TempData["TipoMensaje"]";
            const redireccion = "@TempData["Redireccion"]";

            if (mensaje && mensaje.trim() !== "") {
                const modal = new bootstrap.Modal(document.getElementById("resultModal"));
                const body = document.getElementById("resultModalBody");
                const title = document.getElementById("resultModalLabel");

                title.textContent = (tipo === "exito") ? "Éxito" : "Error";

                if (tipo === "exito") {
                    resultModalHeader.className = "modal-header bg-success text-white";
                } else {
                    resultModalHeader.className = "modal-header bg-danger text-white";
                }

                title.textContent = tipo === "exito" ? "Éxito" : "Error";
                body.textContent = mensaje;
                modal.show();

                document.getElementById("resultModal").addEventListener("hidden.bs.modal", function () {
                    if (tipo === "exito" && redireccion) {
                        window.location.href = `/ADM12_Periodos/${redireccion}`;
                    }
                });
            }
        });
    </script>
}
