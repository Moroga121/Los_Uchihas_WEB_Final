@page "/ADM9_Carreras/Edit/{id}"
@model Proyecto_Nuevo_Avatar_V2.Pages.ADM9_Carreras.EditModel

@{
    ViewData["Title"] = "Editar Carrera";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
<link rel="stylesheet" href="~/css/ADM_Usuarios.css" />

<h2 class="text-center">
    <i class="bi bi-pencil-square"></i> Editar carrera
</h2>

<div class="card shadow p-4">
    <form method="post">
        <div class="form-group mb-3">
            <label for="ID_Carrera" class="form-label">Identificador de la Carrera</label>
            <input asp-for="CarreraEditada.ID_Carrera" class="form-control" readonly />
        </div>

        <div class="form-group mb-3">
            <label for="Nombre" class="form-label">Nombre de la Carrera</label>
            <input asp-for="CarreraEditada.Nombre" class="form-control" placeholder="Ejemplo: Ingeniería en Software" />
            <span asp-validation-for="CarreraEditada.Nombre" class="text-danger"></span>
        </div>

        <div class="form-group mb-3">
            <label for="ID_Institucion" class="form-label">Institución</label>
            <select asp-for="CarreraEditada.ID_Institucion" class="form-control">
                <option value="">-- Seleccione una institución --</option>
                @if (Model.Instituciones != null)
                {
                    foreach (var inst in Model.Instituciones)
                    {
                        <option value="@inst.ID_Institucion" selected="@(inst.ID_Institucion == Model.CarreraEditada.ID_Institucion)">
                            @inst.Nombre
                        </option>
                    }
                }
            </select>
            <span asp-validation-for="CarreraEditada.ID_Institucion" class="text-danger"></span>
        </div>

        <div class="form-group mb-3">
            <label for="ID_Director" class="form-label">Director</label>
            <select asp-for="CarreraEditada.ID_Director" class="form-control">
                <option value="">-- Seleccione un director --</option>
                @if (Model.Profesores != null)
                {
                    foreach (var carrera in Model.Profesores)
                    {
                        <option value="@carrera.ID_Profesor">@carrera.Nombre</option>
                    }
                }
            </select>
            <span asp-validation-for="CarreraEditada.ID_Director" class="text-danger"></span>
        </div>

        <div class="text-center">
            <button type="submit" class="btn btn-warning">
                <i class="bi bi-save"></i> Actualizar
            </button>
            <a asp-page="Index" class="btn btn-secondary">
                <i class="bi bi-arrow-left-circle"></i> Volver
            </a>

        </div>
    </form>
</div>

<!-- Modal de resultado -->
<div class="modal fade" id="resultModal" tabindex="-1" aria-labelledby="resultModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" id="resultModalHeader">
                <h5 class="modal-title" id="resultModalLabel">Resultado</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body" id="resultModalBody">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const mensaje = "@Html.Raw(TempData["Resultado"])";
            const tipo = "@TempData["TipoMensaje"]";
            const redireccion = "@TempData["Redireccion"]";

            if (mensaje && mensaje.trim() !== "") {
                const resultModal = new bootstrap.Modal(document.getElementById("resultModal"));
                const resultModalBody = document.getElementById("resultModalBody");
                const resultModalTitle = document.getElementById("resultModalLabel");

                    resultModalTitle.textContent = (tipo === "exito") ? "Éxito" : "Error";

                    if (tipo === "exito") {
                        resultModalHeader.className = "modal-header bg-success text-white";
                    } else {
                        resultModalHeader.className = "modal-header bg-danger text-white";
                    }

                resultModalTitle.textContent = (tipo === "exito") ? "Éxito" : "Error";
                resultModalBody.textContent = mensaje;

                resultModal.show();

                document.getElementById("resultModal").addEventListener('hidden.bs.modal', function () {
                    if (tipo === "exito" && redireccion) {
                        window.location.href = `/ADM9_Carreras/${redireccion}`;
                    }
                });
            }
        });
    </script>
}
