@page
@model Proyecto_Nuevo_Avatar_V2.Pages.ADM_Prematricula.CreateModel
@{
}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
<link rel="stylesheet" href="~/css/ADM_Usuarios.css" />


<h2 class="text-center">
    <i class="bi bi-plus-circle"></i> Crear nuevo Parámetro
</h2>

<div class="card shadow p-4">
    <form method="post">

        <!-- Número identificación -->
        <div class="form-group mb-3">
            <label class="form-label">Número de Identificación</label>
            <input asp-for="NuevaPrematricula.numero_identificacion" class="form-control" placeholder="Número" />
            <span asp-validation-for="NuevaPrematricula.numero_identificacion" class="text-danger"></span>
        </div>

        <!-- Periodo -->
        <div class="form-group mb-3">
            <label class="form-label">Periodo</label>
            <select asp-for="NuevaPrematricula.Id_Periodo" asp-items="Model.ListaPeriodos" class="form-control">
                <option value="">Seleccione un periodo</option>
            </select>
            <span asp-validation-for="NuevaPrematricula.Id_Periodo" class="text-danger"></span>
        </div>

        <!-- Carrera -->
        <div class="form-group mb-3">
            <label class="form-label">Carrera</label>
            <select asp-for="NuevaPrematricula.carrera" asp-items="Model.ListaCarreras" class="form-control">
                <option value="">Seleccione una carrera</option>
            </select>
            <span asp-validation-for="NuevaPrematricula.carrera" class="text-danger"></span>
        </div>

        <!-- Curso -->
        <div class="form-group mb-3">
            <label class="form-label">Curso</label>
            <select asp-for="NuevaPrematricula.curso" asp-items="Model.ListaCursos" class="form-control">
                <option value="">Seleccione un curso</option>
            </select>
            <span asp-validation-for="NuevaPrematricula.curso" class="text-danger"></span>
        </div>

        <!-- Observaciones -->
        <div class="form-group mb-3">
            <label class="form-label">Observaciones</label>
            <textarea asp-for="NuevaPrematricula.observaciones" class="form-control" placeholder="Observaciones"></textarea>
            <span asp-validation-for="NuevaPrematricula.observaciones" class="text-danger"></span>
        </div>


        <div class="text-center">
            <button type="submit" class="btn btn-success">
                <i class="bi bi-save"></i> Guardar
            </button>
            <a asp-page="Index" class="btn btn-secondary">
                <i class="bi bi-arrow-left-circle"></i> Volver
            </a>
        </div>
    </form>
</div>


<!--Modal de resultados -->
<div class="modal fade" id="resultModal" tabindex="-1" aria-labelledby="resultModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" id="resultModalHeader">
                <h5 class="modal-title" id="resultModalLabel">Resultado</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body" id="resultModalBody">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script><!--Necesario para el uso de los modal-->


    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const mensaje = @Html.Raw(Json.Serialize(TempData["Resultado"]));
            const tipo = "@TempData["TipoMensaje"]";
            const redireccion = "@TempData["Redireccion"]";

            if (mensaje && mensaje.trim() !== "") {
                const resultModalBody = document.getElementById("resultModalBody");
                const resultModalTitle = document.getElementById("resultModalLabel");
                const resultModal = new bootstrap.Modal(document.getElementById("resultModal"));

                    resultModalTitle.textContent = (tipo === "exito") ? "Éxito" : "Error";

                    if (tipo === "exito") {
                        resultModalHeader.className = "modal-header bg-success text-white";
                    } else {
                        resultModalHeader.className = "modal-header bg-danger text-white";
                    }

                resultModalBody.textContent = mensaje;

                // Mostrar el modal
                resultModal.show();

                // Cuando el modal se cierre, redirige
                document.getElementById("resultModal").addEventListener('hidden.bs.modal', function () {
                    if (tipo === "exito" && redireccion) {
                        window.location.href = `/ADM_Prematricula/${redireccion}`;
                    }
                });
            }
        });
    </script>
}
