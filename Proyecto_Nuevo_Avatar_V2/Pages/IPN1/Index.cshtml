@page
@model Proyecto_Nuevo_Avatar_V2.Pages.IPN1.IndexModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Administrar Facturas";
}

<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
<link rel="stylesheet" href="~/css/ADM_Usuarios.css" />
<h2 class="text-center">Administrar Facturas de Matrícula</h2> <p> <a asp-page="/IPN1/Create" class="btn btn-primary"> <i class="fas fa-plus-circle"></i> Nueva Factura </a> </p>
<form method="get" id="formFiltros" class="mb-4">
    <div class="row g-3 align-items-center">
        <div class="col-md-2"> <label for="FiltroPeriodo" class="form-label">Periodo</label> <select asp-for="FiltroPeriodo" class="form-select"> <option value="">Seleccione...</option> </select> </div>

        <div class="col-md-2">
            <label for="FiltroEstudiante" class="form-label">Estudiante</label>
            <select asp-for="FiltroEstudiante" class="form-select">
                <option value="">Seleccione...</option>
            </select>
        </div>

        <div class="col-md-2">
            <label for="FiltroEstado" class="form-label">Estado</label>
            <select asp-for="FiltroEstado" class="form-select">
                <option value="">Seleccione...</option>
            </select>
        </div>
    </div>

    <div class="mt-3 text-end">
        <button type="submit" class="btn btn-success">
            <i class="bi bi-search"></i> Buscar
        </button>

        <a asp-page="Index" class="btn btn-secondary">
            <i class="bi bi-eraser"></i> Limpiar
        </a>
    </div>
</form>
<table class="table table-bordered table-striped" id="tablaFacturas"> <thead class="table-dark"> <tr> <th>Número Factura</th> <th>Periodo</th> <th>Estudiante</th> <th>Estado</th> <th>Acciones</th> </tr> </thead> <tbody> @if (Model.Facturas != null && Model.Facturas.Any()) { @foreach (var factura in Model.Facturas) {
<tr data-id="@factura.Numero_Factura"> <td data-label="" class="text-break">@factura.Numero_Factura</td> <td data-label="" class="text-break">@factura.Periodo</td> <td data-label="" class="text-break">@factura.Identificacion</td> <td data-label="" class="text-break">@factura.Estado_Factura</td> <td> <a asp-page="DetalleFactura" asp-route-id="@factura.Numero_Factura" class="btn btn-info btn-sm"> <i class="fas fa-eye"></i> Ver Detalle </a> <button type="button" class="btn btn-danger btn-sm" onclick="mostrarModalReversar(@factura.Numero_Factura)"> <i class="fas fa-undo"></i> Reversar </button> </td> </tr>
}
  } else
{
    <tr> <td colspan="5" class="text-center">No hay facturas registradas.</td> </tr>
}
 </tbody> </table>
@{
    string BuildQuery(int page)
    {
        var pares = new List<string>();
        if (!string.IsNullOrWhiteSpace(Model.FiltroPeriodo))
            pares.Add($"FiltroPeriodo={Uri.EscapeDataString(Model.FiltroPeriodo)}");
        if (!string.IsNullOrWhiteSpace(Model.FiltroEstudiante))
            pares.Add($"FiltroEstudiante={Uri.EscapeDataString(Model.FiltroEstudiante)}");
        if (!string.IsNullOrWhiteSpace(Model.FiltroEstado))
            pares.Add($"FiltroEstado={Uri.EscapeDataString(Model.FiltroEstado)}");
        pares.Add($"numeroPagina={page}");
        return "?" + string.Join("&", pares);
    }
}

@if (Model.TotalPaginas > 1)
{
    <div id="paginacion" class="my-3 d-flex justify-content-center">
        <nav aria-label="Paginación de facturas">
            <ul class="pagination pagination-sm mb-0">
                @if (Model.PaginaActual > 1)
                {
                    <li class="page-item">
                        <a class="page-link" href="@BuildQuery(Model.PaginaActual - 1)" aria-label="Anterior">
                            <span aria-hidden="true">«</span>
                        </a>
                    </li>
                }

                @for (int i = 1; i <= Model.TotalPaginas; i++)
                {
                    <li class="page-item @(i == Model.PaginaActual ? "active" : "")">
                        <a class="page-link" href="@BuildQuery(i)">@i</a>
                    </li>
                }

                @if (Model.PaginaActual < Model.TotalPaginas)
                {
                    <li class="page-item">
                        <a class="page-link" href="@BuildQuery(Model.PaginaActual + 1)" aria-label="Siguiente">
                            <span aria-hidden="true">&raquo;</span>
                        </a>
                    </li>
                }
            </ul>
        </nav>
    </div>
}

<!-- Modal Reversar Factura --> <div class="modal fade" id="modalReversar" tabindex="-1" aria-hidden="true" data-bs-backdrop="static"> <div class="modal-dialog modal-dialog-centered"> <div class="modal-content"> <form method="post" asp-page-handler="ReversarFactura"> <div class="modal-header bg-warning text-dark"> <h5 class="modal-title"> <i class="fas fa-exclamation-triangle"></i> Confirmación de Reversión </h5> <button type="button" class="btn-close" data-bs-dismiss="modal"></button> </div> <div class="modal-body"> <input type="hidden" id="numeroFacturaReversar" name="NumeroFactura" /> <div class="mb-3"> <label for="motivoReversa" class="form-label">Motivo de la reversión</label> <textarea id="motivoReversa" name="Motivo" class="form-control" rows="3" placeholder="Explique el motivo..." required></textarea> </div> </div> <div class="modal-footer"> <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"> Cancelar </button> <button type="submit" class="btn btn-success" id="btnConfirmarReversar" disabled> Confirmar </button> </div> </form> </div> </div> </div> <!-- Modal de Resultado --> <div class="modal fade" id="resultModal" tabindex="-1" aria-hidden="true"> <div class="modal-dialog modal-dialog-centered"> <div class="modal-content"> <div class="modal-header" id="resultModalHeader"> <h5 class="modal-title" id="resultModalLabel">Resultado</h5> <button type="button" class="btn-close" data-bs-dismiss="modal"></button> </div> <div class="modal-body" id="resultModalBody"></div> <div class="modal-footer"> <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button> </div> </div> </div> </div>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        llenarFiltros();

        function llenarFiltros() {
            const filas = document.querySelectorAll('#tablaFacturas tbody tr[data-id]');
            const periodos = new Set();
            const estudiantes = new Set();
            const estados = new Set();

            filas.forEach(fila => {
                if (fila.cells.length > 1) {
                    // Acceder a las celdas por índice correcto
                    const periodo = fila.cells[1].textContent.trim();      // Columna Periodo
                    const estudiante = fila.cells[2].textContent.trim();   // Columna Estudiante
                    const estado = fila.cells[3].textContent.trim();       // Columna Estado

                    if (periodo) periodos.add(periodo);
                    if (estudiante) estudiantes.add(estudiante);
                    if (estado) estados.add(estado);
                }
            });

            const selectPeriodo = document.getElementById('FiltroPeriodo');
            const selectEstudiante = document.getElementById('FiltroEstudiante');
            const selectEstado = document.getElementById('FiltroEstado');

            const valorPeriodo = selectPeriodo.value;
            const valorEstudiante = selectEstudiante.value;
            const valorEstado = selectEstado.value;

            // Llenar select de Periodo
            Array.from(periodos).sort().forEach(p => {
                if (!Array.from(selectPeriodo.options).some(opt => opt.value === p)) {
                    const option = document.createElement('option');
                    option.value = p;
                    option.textContent = p;
                    selectPeriodo.appendChild(option);
                }
            });

            // Llenar select de Estudiante
            Array.from(estudiantes).sort().forEach(e => {
                if (!Array.from(selectEstudiante.options).some(opt => opt.value === e)) {
                    const option = document.createElement('option');
                    option.value = e;
                    option.textContent = e;
                    selectEstudiante.appendChild(option);
                }
            });

            // Llenar select de Estado
            Array.from(estados).sort().forEach(es => {
                if (!Array.from(selectEstado.options).some(opt => opt.value === es)) {
                    const option = document.createElement('option');
                    option.value = es;
                    option.textContent = es;
                    selectEstado.appendChild(option);
                }
            });

            // Restaurar valores seleccionados previamente
            selectPeriodo.value = valorPeriodo;
            selectEstudiante.value = valorEstudiante;
            selectEstado.value = valorEstado;
        }
    });

    function mostrarModalReversar(numeroFactura) {
        const motivo = document.getElementById('motivoReversa');
        const btnConfirmar = document.getElementById('btnConfirmarReversar');

        document.getElementById('numeroFacturaReversar').value = numeroFactura;
        motivo.value = '';
        btnConfirmar.disabled = true;

        motivo.addEventListener('input', function () {
            btnConfirmar.disabled = motivo.value.trim().length === 0;
        });

        var modal = new bootstrap.Modal(document.getElementById('modalReversar'));
        modal.show();
    }
</script>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @if (!string.IsNullOrEmpty(Model.ModalMessage))
    {
        <script>
            document.addEventListener('DOMContentLoaded', function() {
            var modalTitle = '@Html.Raw(Model.ModalTitle)';
            var modalMessage = '@Html.Raw(Model.ModalMessage)';
            var modalType = '@Model.ModalType';

                        document.getElementById('resultModalLabel').textContent = modalTitle;
                        document.getElementById('resultModalBody').innerHTML = modalMessage;

                        var modalHeader = document.getElementById('resultModalHeader');
                        if (modalType === 'success') {
                            modalHeader.classList.remove('bg-danger', 'bg-info', 'text-white');
                            modalHeader.classList.add('bg-success', 'text-white');
                        } else if (modalType === 'info') {
                            modalHeader.classList.remove('bg-danger', 'bg-success', 'text-white');
                            modalHeader.classList.add('bg-info', 'text-white');
                        } else {
                            modalHeader.classList.remove('bg-success', 'bg-info', 'text-white');
                            modalHeader.classList.add('bg-danger', 'text-white');
                        }

                        var modal = new bootstrap.Modal(document.getElementById('resultModal'));
                        modal.show();
                    });
        </script>
    }
}