@page
@model Proyecto_Nuevo_Avatar_V2.Pages.IPN1.CreateModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Crear Factura de Matrícula";
}

<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
<link rel="stylesheet" href="~/css/ADM_Usuarios.css" />

<h2 class="text-center">
    <i class="fas fa-plus-circle"></i> Crear Factura de Matrícula
</h2>

<div class="card shadow p-4">
    <form method="post">
        <div class="form-group mb-3">
            <label for="NumeroIdentificacion" class="form-label">Número de Identificación del Estudiante</label>
            <input asp-for="NumeroIdentificacion"
                   class="form-control"
                   placeholder="Ej: 305650418"
                   maxlength="22" />
            <span asp-validation-for="NumeroIdentificacion" class="text-danger"></span>
        </div>

        <div class="form-group mb-3">
            <label for="Detalle" class="form-label">Detalle de la Factura</label>
            <input type="text"
                   id="Detalle"
                   class="form-control"
                   value="Servicios estudiantiles"
                   readonly
                   style="background-color: #e9ecef;" />
        </div>

        <div class="text-center">
            <button type="submit" class="btn btn-success">
                <i class="bi bi-save"></i> Crear Factura
            </button>
            <a asp-page="Index" class="btn btn-secondary">
                <i class="bi bi-arrow-left-circle"></i> Volver
            </a>
        </div>
    </form>
</div>

<!-- Modal de Resultado -->
<div class="modal fade" id="resultModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-success text-white" id="resultModalHeader">
                <h5 class="modal-title" id="resultModalLabel">Resultado</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="resultModalBody"></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    @if (!string.IsNullOrEmpty(Model.ModalMessage))
    {
        <script>
            document.addEventListener('DOMContentLoaded', function() {
                var modalTitle = '@Html.Raw(Model.ModalTitle)';
                var modalMessage = `@Html.Raw(Model.ModalMessage)`; // backticks
                var modalType = '@Model.ModalType';

                document.getElementById('resultModalLabel').textContent = modalTitle;
                document.getElementById('resultModalBody').innerHTML = modalMessage;

                var modalHeader = document.getElementById('resultModalHeader');
                modalHeader.classList.remove('bg-success', 'bg-danger', 'bg-warning', 'text-white');

                if (modalType === 'success') {
                    modalHeader.classList.add('bg-success', 'text-white');
                } else {
                    modalHeader.classList.add('bg-danger', 'text-white');
                }

                var modal = new bootstrap.Modal(document.getElementById('resultModal'));
                modal.show();
            });
        </script>
    }
}
