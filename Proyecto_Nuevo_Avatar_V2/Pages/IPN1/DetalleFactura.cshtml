@page
@model Proyecto_Nuevo_Avatar_V2.Pages.IPN1.DetalleFacturaModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Detalle de Factura";
}

<h2 class="text-center">Detalle de Factura</h2>

<div class="card shadow p-4">
    <form>

        <div class="form-group mb-3">
            <label for="Numero_Factura" class="form-label">Número de Factura</label>
            <input asp-for="Factura.Numero_Factura" class="form-control" readonly />
        </div>

        <div class="form-group mb-3">
            <label for="Identificacion" class="form-label">Identificación</label>
            <input asp-for="Factura.Identificacion" class="form-control" readonly />
        </div>

        <div class="form-group mb-3">
            <label for="MontoBase" class="form-label">Monto Base</label>
            <input asp-for="Factura.MontoBase" class="form-control" readonly />
        </div>

        <div class="form-group mb-3">
            <label for="IVA" class="form-label">IVA</label>
            <input asp-for="Factura.IVA" class="form-control" readonly />
        </div>

        <div class="form-group mb-3">
            <label for="MontoTotal" class="form-label">Monto Total</label>
            <input asp-for="Factura.MontoTotal" class="form-control" readonly />
        </div>

        <div class="form-group mb-3">
            <label for="Detalle" class="form-label">Detalle</label>
            <input asp-for="Factura.Detalle" class="form-control" readonly />
        </div>

        <div class="form-group mb-3">
            <label for="Fecha_Creacion" class="form-label">Fecha Creación</label>
            <textarea asp-for="Factura.Fecha_Creacion" class="form-control" rows="3" readonly></textarea>
        </div>

        <div class="form-group mb-3">
            <label for="Estado_Factura" class="form-label">Estado</label>
            <input asp-for="Factura.Estado_Factura" class="form-control" readonly />
        </div>

        <div class="form-group mb-3">
            <label for="Periodo" class="form-label">Periodo</label>
            <input asp-for="Factura.Periodo" class="form-control" readonly />
        </div>

        <div class="form-group mb-3">
            <label for="Motivo_Reversa" class="form-label">Motivo de Reversión</label>
            <textarea class="form-control" rows="3" readonly>@(string.IsNullOrEmpty(Model.Factura.Motivo) ? "N/A" : Model.Factura.Motivo)</textarea>
        </div>

        <div class="form-group mb-3">
            <label for="Fecha_Reversa" class="form-label">Fecha de Reversión</label>
            <input type="text" value="@(Model.Factura.Fecha_Reversa == default(DateTime) ? "N/A" : Model.Factura.Fecha_Reversa.ToString("dd/MM/yyyy HH:mm"))" class="form-control" readonly />
        </div>

        <div class="text-center">
            <a  type="button" class="btn btn-secondary" asp-page="/IPN1/Index">
                Volver
                </a>
        </div>

    </form>
</div>


<script>
    function cerrarOVolver() {
        window.close();
        setTimeout(function() {
            if (!window.closed) {
                window.history.back();
            }
        }, 100);
    }
</script>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
}
