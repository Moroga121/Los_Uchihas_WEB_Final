@page
@model Proyecto_Nuevo_Avatar_V2.Pages.ACA2.IndexModel

@{
    Layout = "_Layout";
    ViewData["Title"] = "Listado de Estudiantes por Periodo";
}

<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

<link rel="stylesheet" href="~/css/ADM_Usuarios.css" />

<h2 class="text-center">Listado de Estudiantes por Periodo</h2>

<form method="post" asp-page-handler="Buscar" id="formFiltros" class="mb-4">
    <div class="row g-3 align-items-center">

        <div class="col-md-2">
            <label asp-for="Periodo" class="form-label">Periodo</label>
            <select asp-for="Periodo" class="form-select" required>
                <option value="">Seleccione...</option>
                @foreach (var periodo in Model.Periodos)
                {
                    <option value="@periodo.Value" selected="@(periodo.Value == Model.Periodo)">@periodo.Text</option>
                }
            </select>
        </div>

        <div class="col-md-2">
            <label for="filtroCarrera" class="form-label">Carrera</label>
            <select id="filtroCarrera" name="FiltroCarrera" class="form-select">
                <option value="">Todas</option>
            </select>
        </div>

        <div class="col-md-2">
            <label for="filtroCurso" class="form-label">Curso</label>
            <select id="filtroCurso" name="FiltroCurso" class="form-select">
                <option value="">Todos</option>
            </select>
        </div>

        <div class="col-md-2">
            <label for="filtroGrupo" class="form-label">Grupo</label>
            <select id="filtroGrupo" name="FiltroGrupo" class="form-select">
                <option value="">Todos</option>
            </select>
        </div>
    </div>

    <div class="mt-3 text-end">
        <button type="submit" class="btn btn-success" id="btnBuscar">
            <i class="bi bi-search"></i> Buscar
        </button>

        <a asp-page="Index" class="btn btn-secondary">
            <i class="bi bi-eraser"></i> Limpiar
        </a>
    </div>
</form>


@if (Model.Estudiantes != null && Model.Estudiantes.Any())
{
    <div class="mb-3 text-end">
        <form method="post" asp-page-handler="ExportCSV" style="display: inline;">
            <input type="hidden" name="Periodo" value="@Model.Periodo" />
            <input type="hidden" id="filtroCarreraCSV" name="FiltroCarrera" value="" />
            <input type="hidden" id="filtroCursoCSV" name="FiltroCurso" value="" />
            <input type="hidden" id="filtroGrupoCSV" name="FiltroGrupo" value="" />
            <button type="submit" class="btn btn-success" onclick="copiarFiltros('CSV')">
                <i class="fas fa-file-csv"></i> Exportar a CSV
            </button>
        </form>
        <form method="post" asp-page-handler="ExportPDF" style="display: inline;">
            <input type="hidden" name="Periodo" value="@Model.Periodo" />
            <input type="hidden" id="filtroCarreraPDF" name="FiltroCarrera" value="" />
            <input type="hidden" id="filtroCursoPDF" name="FiltroCurso" value="" />
            <input type="hidden" id="filtroGrupoPDF" name="FiltroGrupo" value="" />
            <button type="submit" class="btn btn-danger" onclick="copiarFiltros('PDF')">
                <i class="fas fa-file-pdf"></i> Exportar a PDF
            </button>
        </form>
    </div>
}

<table class="table table-bordered table-striped" id="tablaEstudiantes">
    <thead class="table-dark">
        <tr>
            <th>Identificación</th>
            <th>Tipo Identificación</th>
            <th>Nombre Completo</th>
            <th>Carrera</th>
            <th>Curso</th>
            <th>Grupo</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Estudiantes != null && Model.Estudiantes.Any())
        {
            @foreach (var estudiante in Model.Estudiantes)
            {
                <tr data-carrera="@estudiante.Carrera"
                    data-curso="@estudiante.Curso"
                    data-grupo="@estudiante.Grupo">
                    <td data-label="" class="text-break">@estudiante.Numero_Identificacion</td>
                    <td data-label="" class="text-break">@estudiante.Tipo_Identificacion</td>
                    <td data-label="" class="text-break">@estudiante.Nombre_Completo</td>
                    <td data-label="" class="text-break">@estudiante.Carrera</td>
                    <td data-label="" class="text-break">@estudiante.Curso</td>
                    <td data-label="" class="text-break">@estudiante.Grupo</td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="6" class="text-center">No se encontraron registros.</td>
            </tr>
        }
    </tbody>
</table>

@{
    string BuildQuery(int page)
    {
        var pares = new List<string>();

        pares.Add("handler=Buscar");

        if (!string.IsNullOrWhiteSpace(Model.Periodo))
            pares.Add($"Periodo={Uri.EscapeDataString(Model.Periodo)}");
        if (!string.IsNullOrWhiteSpace(Model.FiltroCarrera))
            pares.Add($"FiltroCarrera={Uri.EscapeDataString(Model.FiltroCarrera)}");
        if (!string.IsNullOrWhiteSpace(Model.FiltroCurso))
            pares.Add($"FiltroCurso={Uri.EscapeDataString(Model.FiltroCurso)}");
        if (!string.IsNullOrWhiteSpace(Model.FiltroGrupo))
            pares.Add($"FiltroGrupo={Uri.EscapeDataString(Model.FiltroGrupo)}");

        pares.Add($"numeroPagina={page}");

        return "?" + string.Join("&", pares);
    }
}



@if (Model.TotalPaginas > 1)
{
    <div id="paginacion" class="my-3 d-flex justify-content-center">
        <nav aria-label="Paginación de estudiantes">
            <ul class="pagination pagination-sm mb-0">
                @if (Model.PaginaActual > 1)
                {
                    <li class="page-item">
                        <a class="page-link" href="@BuildQuery(Model.PaginaActual - 1)" aria-label="Anterior">
                            <span>Anterior</span>
                        </a>
                    </li>
                }

                @for (int i = 1; i <= Model.TotalPaginas; i++)
                {
                    <li class="page-item @(i == Model.PaginaActual ? "active" : "")">
                        <a class="page-link" href="@BuildQuery(i)">@i</a>
                    </li>
                }

                @if (Model.PaginaActual < Model.TotalPaginas)
                {
                    <li class="page-item">
                        <a class="page-link" href="@BuildQuery(Model.PaginaActual + 1)" aria-label="Siguiente">
                            <span>Siguiente</span>
                        </a>
                    </li>
                }
            </ul>
        </nav>
    </div>
}



@if (Model.Estudiantes != null && Model.Estudiantes.Any())
{
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            llenarFiltros();
            restaurarFiltrosGuardados();

            var btnAplicarTodo = document.getElementById('btnAplicarTodo');
            if (btnAplicarTodo) {
                btnAplicarTodo.addEventListener('click', function() {
                    guardarFiltros();
                    document.getElementById('formFiltros').submit();
                });
            }

            function llenarFiltros() {
                var filas = document.querySelectorAll('#tablaEstudiantes tbody tr');
                var carreras = new Set();
                var cursos = new Set();
                var grupos = new Set();

                filas.forEach(function(fila) {
                    if (fila.dataset.carrera) {
                        carreras.add(fila.dataset.carrera);
                        cursos.add(fila.dataset.curso);
                        grupos.add(fila.dataset.grupo);
                    }
                });

                var selectCarrera = document.getElementById('filtroCarrera');
                if (selectCarrera) {
                    Array.from(carreras).sort().forEach(function(carrera) {
                        var option = document.createElement('option');
                        option.value = carrera;
                        option.textContent = carrera;
                        selectCarrera.appendChild(option);
                    });
                }

                var selectCurso = document.getElementById('filtroCurso');
                if (selectCurso) {
                    Array.from(cursos).sort().forEach(function(curso) {
                        var option = document.createElement('option');
                        option.value = curso;
                        option.textContent = curso;
                        selectCurso.appendChild(option);
                    });
                }

                var selectGrupo = document.getElementById('filtroGrupo');
                if (selectGrupo) {
                    Array.from(grupos).sort().forEach(function(grupo) {
                        var option = document.createElement('option');
                        option.value = grupo;
                        option.textContent = grupo;
                        selectGrupo.appendChild(option);
                    });
                }
            }

            function guardarFiltros() {
                var carrera = document.getElementById('filtroCarrera');
                var curso = document.getElementById('filtroCurso');
                var grupo = document.getElementById('filtroGrupo');

                if (carrera) localStorage.setItem('filtroCarrera', carrera.value);
                if (curso) localStorage.setItem('filtroCurso', curso.value);
                if (grupo) localStorage.setItem('filtroGrupo', grupo.value);
            }

            function restaurarFiltrosGuardados() {
                var carrera = localStorage.getItem('filtroCarrera');
                var curso = localStorage.getItem('filtroCurso');
                var grupo = localStorage.getItem('filtroGrupo');

                var selectCarrera = document.getElementById('filtroCarrera');
                var selectCurso = document.getElementById('filtroCurso');
                var selectGrupo = document.getElementById('filtroGrupo');

                if (carrera && selectCarrera) selectCarrera.value = carrera;
                if (curso && selectCurso) selectCurso.value = curso;
                if (grupo && selectGrupo) selectGrupo.value = grupo;

                if (carrera || curso || grupo) {
                    aplicarFiltros();
                }
            }

            function aplicarFiltros() {
                var selectCarrera = document.getElementById('filtroCarrera');
                var selectCurso = document.getElementById('filtroCurso');
                var selectGrupo = document.getElementById('filtroGrupo');

                if (!selectCarrera || !selectCurso || !selectGrupo) return;

                var filtroCarrera = selectCarrera.value.toLowerCase();
                var filtroCurso = selectCurso.value.toLowerCase();
                var filtroGrupo = selectGrupo.value.toLowerCase();

                var filas = document.querySelectorAll('#tablaEstudiantes tbody tr');
                var contador = 0;

                filas.forEach(function(fila) {
                    if (!fila.dataset.carrera) return;

                    var carrera = fila.dataset.carrera.toLowerCase();
                    var curso = fila.dataset.curso.toLowerCase();
                    var grupo = fila.dataset.grupo.toLowerCase();

                    var coincideCarrera = !filtroCarrera || carrera === filtroCarrera;
                    var coincideCurso = !filtroCurso || curso === filtroCurso;
                    var coincideGrupo = !filtroGrupo || grupo === filtroGrupo;

                    if (coincideCarrera && coincideCurso && coincideGrupo) {
                        fila.style.display = '';
                        contador++;
                    } else {
                        fila.style.display = 'none';
                    }
                });

                var contadorElement = document.getElementById('contadorResultados');
                if (contadorElement) {
                    contadorElement.textContent = contador;
                }
            }

            window.copiarFiltros = function(tipo) {
                var carrera = document.getElementById('filtroCarrera');
                var curso = document.getElementById('filtroCurso');
                var grupo = document.getElementById('filtroGrupo');

                var carreraExport = document.getElementById('filtroCarrera' + tipo);
                var cursoExport = document.getElementById('filtroCurso' + tipo);
                var grupoExport = document.getElementById('filtroGrupo' + tipo);

                if (carrera && carreraExport) carreraExport.value = carrera.value;
                if (curso && cursoExport) cursoExport.value = curso.value;
                if (grupo && grupoExport) grupoExport.value = grupo.value;
            }
        });
    </script>
}
else
{
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var btnAplicarTodo = document.getElementById('btnAplicarTodo');
            if (btnAplicarTodo) {
                btnAplicarTodo.addEventListener('click', function() {
                    var form = document.getElementById('formFiltros');
                    if (form) {
                        form.submit();
                    }
                });
            }
        });
    </script>
}
