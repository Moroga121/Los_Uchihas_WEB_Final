@page
@model Proyecto_Nuevo_Avatar_V2.Pages.ADM_Usuarios.IndexModel
@{

    Layout = "_Layout";
    ViewData["Title"] = "Administrar Usuarios";

}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
<link rel="stylesheet" href="~/css/ADM_Usuarios.css" />

<h2 class="text-center">Gestión de Usuarios</h2>

<p>
    <a asp-page="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Crear nuevo Usuario
    </a>

</p>

<form method="get" id="filtroForm" class="mb-4">
    <div class="row g-3 align-items-center">

        <div class="col-md-2">
            <label for="FiltroIdentificacion" class="form-label">Identificación</label>
            <input type="text" class="form-control" id="FiltroIdentificacion" name="FiltroIdentificacion"
                   value="@Model.FiltroIdentificacion" placeholder="Ej: 305650418" />
        </div>

        <div class="col-md-3">
            <label for="FiltroNombre" class="form-label">Nombre</label>
            <input type="text" class="form-control" id="FiltroNombre" name="FiltroNombre"
                   value="@Model.FiltroNombre" placeholder="Ej: Gabriel" />
        </div>


        <div class="col-md-2">
            <label for="FiltroTipo" class="form-label">Tipo</label>
            <select id="FiltroTipo" name="FiltroTipo" class="form-select">
                <option value="">Seleccione un Tipo de Identificación</option>
                @foreach (var tipos_ident in Model.TiposIdentificacion)
                {
                    <option value="@tipos_ident.ID_Identificacion" selected="@(Model.FiltroTipo == tipos_ident.ID_Identificacion)">
                        @tipos_ident.Tipo_Identificacion
                    </option>
                }
            </select>
        </div>

        <div class="col-md-2">
            <label for="FiltroDominio" class="form-label">Dominio</label>
            <select id="FiltroDominio" name="FiltroDominio" class="form-select">
                <option value="">Seleccione un Dominio</option>
                @foreach (var dominio in Model.Dominios)
                {
                    <option value="@dominio.Email" selected="@(Model.FiltroDominio == dominio.Email)">
                        @dominio.Email
                    </option>
                }
            </select>
        </div>

        <div class="col-md-2">
            <label for="FiltroRol" class="form-label">Rol</label>
            <select id="FiltroRol" name="FiltroRol" class="form-select">
                <option value="">Seleccione un Rol</option>
                @foreach (var rol in Model.Roles)
                {
                    <option value="@rol.Identificador_Rol" selected="@(Model.FiltroRol == rol.Identificador_Rol)">
                        @rol.Nombre_Rol
                    </option>
                }
            </select>
        </div>
    </div>

    <div class="mt-3 text-end">

        <button type="submit" class="btn btn-success" id="btnBuscar">
            <i class="bi bi-search"></i> Buscar
        </button>

        <a asp-page="Index" class="btn btn-secondary">
            <i class="bi bi-eraser"></i> Limpiar
        </a>

    </div>
</form>


<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>Identificación</th>
            <th>Tipo Identificación</th>
            <th>Nombre</th>
            <th>Email</th>
            <th>Contraseña</th>
            <th>Rol Usuario</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Usuarios != null && Model.Usuarios.Any())
        {
            foreach (var usu in Model.Usuarios)
            {
                <tr>
                    <td data-label="" class="text-break">@usu.Identificacion</td>
                    <td >@usu.Tipo_Identificacion</td>
                    <td data-label ="" class="text-break">@usu.Nombre</td>
                    <td data-label="" class="text-break">@usu.Email</td>
                    <td>@usu.Contrasena</td>
                    <td>@usu.Rol_Usuario</td>
                    <td>
                        <a asp-page="Edit" asp-route-id="@usu.Identificacion" class="btn btn-warning btn-sm">
                            <i class="bi bi-pencil-square"></i> Editar
                        </a>
                        <button type="button"
                                class="btn btn-danger btn-sm"
                                data-bs-toggle="modal"
                                data-bs-target="#confirmDeleteModal"
                                data-id="@usu.Identificacion"
                                data-nombre="@usu.Nombre">
                            <i class="bi bi-trash3"></i> Eliminar
                        </button>

                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="3" class="text-center">No hay Usuarios registrados.</td>
            </tr>
        }
    </tbody>
</table>


@if (Model.TotalPaginas > 1)
{
    <div id="paginacion" class="my-3 d-flex justify-content-center">
        <nav aria-label="Paginación de parámetros">
            <ul class="pagination pagination-sm mb-0">
                <!-- Botón Página Anterior -->
                @if (Model.PaginaActual > 1)
                {
                    <li class="page-item">
                        <a class="page-link" href="?numeroPagina=@(Model.PaginaActual - 1)" aria-label="Anterior">
                            <span aria-hidden="true">&laquo;</span>
                        </a>
                    </li>
                }

                <!-- Números de Página -->
                @for (int i = 1; i <= Model.TotalPaginas; i++)
                {
                    <li class="page-item @(i == Model.PaginaActual ? "active" : "")">
                        <a class="page-link" href="?numeroPagina=@i">@i</a>
                    </li>
                }

                <!-- Botón Página Siguiente -->
                @if (Model.PaginaActual < Model.TotalPaginas)
                {
                    <li class="page-item">
                        <a class="page-link" href="?numeroPagina=@(Model.PaginaActual + 1)" aria-label="Siguiente">
                            <span aria-hidden="true">&raquo;</span>
                        </a>
                    </li>
                }
            </ul>
        </nav>
    </div>
}




<!--Modal de resultados -->
<div class="modal fade" id="resultModal" tabindex="-1" aria-labelledby="resultModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" id="resultModalHeader">
                <h5 class="modal-title" id="resultModalLabel">Resultado</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body" id="resultModalBody">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

<!--Modal de confirmación de eliminación -->
<div class="modal fade" id="confirmDeleteModal" tabindex="-1" aria-labelledby="confirmDeleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="confirmDeleteModalLabel">Confirmar eliminación</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                ¿Seguro que deseas eliminar el Usuario <strong id="UsuarioIdentificacion"></strong>?
            </div>
            <div class="modal-footer">
                <form method="post" asp-page-handler="Delete" id="deleteForm">
                    <input type="hidden" name="id" id="UsuarioIDEliminar" />
                    <button type="submit" class="btn btn-danger">Sí, eliminar</button>
                </form>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const mensaje = @Html.Raw(Json.Serialize(TempData["Resultado"]));
            const tipo = "@TempData["TipoMensaje"]";

            if (mensaje && mensaje.trim() !== "") {
                const resultModalBody = document.getElementById("resultModalBody");
                const resultModalTitle = document.getElementById("resultModalLabel");

                resultModalTitle.textContent = (tipo === "exito") ? "Éxito" : "Error";

                    if (tipo === "exito") {
                        resultModalHeader.className = "modal-header bg-success text-white";
                    } else {
                        resultModalHeader.className = "modal-header bg-danger text-white";
                    }

                if (tipo === "exito") {
                    resultModalTitle.textContent = "Éxito";
                    resultModalBody.textContent = mensaje;
                } else {
                    resultModalTitle.textContent = "Error";
                    resultModalBody.textContent = mensaje;
                }

                const modal = new bootstrap.Modal(document.getElementById("resultModal"));
                modal.show();
            }
        });

        // Configurar datos dinámicos para el modal de confirmación
        const confirmDeleteModal = document.getElementById('confirmDeleteModal');
        confirmDeleteModal.addEventListener('show.bs.modal', function (event) {
            const button = event.relatedTarget;
            const identificacion = button.getAttribute('data-id');
            const nombreusu = button.getAttribute('data-nombre');

            document.getElementById('UsuarioIDEliminar').value = identificacion;
            document.getElementById('UsuarioIdentificacion').innerText = nombreusu;
        });







        document.addEventListener("DOMContentLoaded", function () {
            const form = document.getElementById("filtroForm");
            const buscarBtn = document.getElementById("btnBuscar");

            // 🔹 Evita comportamiento extraño del botón
            buscarBtn.addEventListener("click", function (e) {
                e.preventDefault();
                form.submit();
            });


        });



    </script>
}