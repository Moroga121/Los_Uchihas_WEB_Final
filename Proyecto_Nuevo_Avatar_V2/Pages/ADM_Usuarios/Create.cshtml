@page
@model Proyecto_Nuevo_Avatar_V2.Pages.ADM_Usuarios.CreateModel
@{
}


<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
<link rel="stylesheet" href="~/css/ADM_Usuarios.css" />


<h2 class="text-center">
    <i class="bi bi-plus-circle"></i> Crear nuevo Usuario
</h2>


<div class="card shadow p-4">
    <form method="post">
        <div class="form-group mb-3">
            <label for="Identificacion" class="form-label">Identificacion</label>
            <input asp-for="NuevoUsuario.Identificacion" class="form-control" placeholder="Ejemplo: 111111111" />
            <span asp-validation-for="NuevoUsuario.Identificacion" class="text-danger"></span>
        </div>

        <div class="form-group mb-3">
            <label for="Tipo_Identificacion" class="form-label">Tipo de Identificacion</label>
            <select asp-for="NuevoUsuario.Tipo_Identificacion" asp-items="Model.ListaTipos" class="form-control">
                <option value="">-- Seleccione un tipo --</option>
            </select>
            <span asp-validation-for="NuevoUsuario.Tipo_Identificacion" class="text-danger"></span>
        </div>

        <div class="form-group mb-3">
            <label for="Nombre" class="form-label">Nombre</label>
            <input asp-for="NuevoUsuario.Nombre" class="form-control" placeholder="Ejemplo: Isaac" />
            <span asp-validation-for="NuevoUsuario.Nombre" class="text-danger"></span>
        </div>

        <div class="form-group mb-3">
            <label for="Email" class="form-label">Email</label>
            <input asp-for="NuevoUsuario.Email" class="form-control" placeholder="Ejemplo: xxxxxxxx@cuc.cr" />
            <span asp-validation-for="NuevoUsuario.Email" class="text-danger"></span>
        </div>

        <div class="form-group mb-3">
            <label for="Contrasena" class="form-label">Contraseña</label>
            <input asp-for="NuevoUsuario.Contrasena" class="form-control" type="password" />
            <span asp-validation-for="NuevoUsuario.Contrasena" class="text-danger"></span>
        </div>

        <div class="form-group mb-3">
            <label for="Rol_Usuario" class="form-label">Rol del Usuario</label>
            <select asp-for="NuevoUsuario.Rol_Usuario" asp-items="Model.ListaRoles" class="form-control">
                <option value="">-- Seleccione un rol --</option>
            </select>
            <span asp-validation-for="NuevoUsuario.Rol_Usuario" class="text-danger"></span>
        </div>

        <div class="text-center">
            <button type="submit" class="btn btn-success">
                <i class="bi bi-save"></i> Guardar
            </button>
            <a asp-page="Index" class="btn btn-secondary">
                <i class="bi bi-arrow-left-circle"></i> Volver
            </a>
        </div>
    </form>
</div>
<!--Modal de resultados -->
<div class="modal fade" id="resultModal" tabindex="-1" aria-labelledby="resultModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" id="resultModalHeader">
                <h5 class="modal-title" id="resultModalLabel">Resultado</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body" id="resultModalBody">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script><!--Necesario para el uso de los modal-->


    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const mensaje = @Html.Raw(Json.Serialize(TempData["Resultado"]));
            const tipo = "@TempData["TipoMensaje"]";
            const redireccion = "@TempData["Redireccion"]";

            if (mensaje && mensaje.trim() !== "") {
                const resultModalBody = document.getElementById("resultModalBody");
                const resultModalTitle = document.getElementById("resultModalLabel");
                const resultModal = new bootstrap.Modal(document.getElementById("resultModal"));

                resultModalTitle.textContent = (tipo === "exito") ? "Éxito" : "Error";

                    if (tipo === "exito") {
                        resultModalHeader.className = "modal-header bg-success text-white";
                    } else {
                        resultModalHeader.className = "modal-header bg-danger text-white";
                    }

                resultModalBody.textContent = mensaje;

                // Mostrar el modal
                resultModal.show();

                // Cuando el modal se cierre, redirige
                document.getElementById("resultModal").addEventListener('hidden.bs.modal', function () {
                    if (tipo === "exito" && redireccion) {
                        window.location.href = `/ADM_Usuarios/${redireccion}`;
                    }
                });
            }
        });
    </script>
}