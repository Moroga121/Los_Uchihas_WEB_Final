@page
@model Proyecto_Nuevo_Avatar_V2.Pages.ADM17_Notas.AsignarNotaModel
@{
}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
<link rel="stylesheet" href="~/css/ADM_Usuarios.css" />

<h2 class="mt-3">
    Asignar Notas — Curso: @Model.Curso — Grupo: @Model.Grupo — Estudiante: @Model.Identificacion
</h2>

<hr />

@if (!Model.TieneDesglose)
{
    <p>Sin desglose.</p>

    <a asp-page="/ADM17_Notas/Index" class="btn btn-secondary">
        Volver
    </a>
}
else if (!Model.TieneNotas && !Model.ModoAgregar)
{
    <p>Sin notas.</p>

    <a asp-page="./AsignarNota"
       asp-route-curso="@Model.Curso"
       asp-route-grupo="@Model.Grupo"
       asp-route-identificacion="@Model.Identificacion"
       asp-route-agregar="true"
       class="btn btn-primary">
        Agregar notas
    </a>

    <a asp-page="/ADM17_Notas/Index" class="btn btn-secondary ms-2">
        Volver
    </a>
}
else
{
    <!-- Aquí va tu formulario con la tabla -->
    <form method="post">

        <input type="hidden" name="Curso" value="@Model.Curso" />
        <input type="hidden" name="Grupo" value="@Model.Grupo" />
        <input type="hidden" name="Identificacion" value="@Model.Identificacion" />

        <table class="table table-bordered table-hover mt-3 text-center align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Rubro</th>
                    <th>Nota</th>
                    <th>Acción</th>
                </tr>
            </thead>

            <tbody>
                @for (int i = 0; i < Model.Rubros.Count; i++)
                {
                    var rubro = Model.Rubros[i];
                    var nota = Model.notas?.FirstOrDefault(n => n.id_rubro == rubro.id_rubro);

                    <tr>
                        <td>@rubro.nombre</td>

                        <td>
                            <input type="number"
                                   step="0.01"
                                   max="100"
                                   min="0"
                                   class="form-control"
                                   name="notas[@i].valor"
                                   value="@(nota?.valor?.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) ?? "")" />

                            <input type="hidden" name="notas[@i].id_rubro" value="@rubro.id_rubro" />
                            <input type="hidden" name="notas[@i].numero_identificacion" value="@Model.Identificacion" />
                        </td>

                        <td>
                            @if (nota == null || nota.valor == null)
                            {
                                <button type="submit"
                                        formaction="?handler=Guardar&rowIndex=@i&accion=Insert"
                                        class="btn btn-primary">
                                    Crear
                                </button>
                            }
                            else
                            {
                                <button type="submit"
                                        formaction="?handler=Guardar&rowIndex=@i&accion=Update"
                                        class="btn btn-warning">
                                    Editar
                                </button>
                            }
                        </td>




                    </tr>
                }
            </tbody>
        </table>

        <a asp-page="/ADM17_Notas/Index" class="btn btn-secondary ms-2">Volver</a>
    </form>
}


    <!--Modal de resultados -->
    <div class="modal fade" id="resultModal" tabindex="-1" aria-labelledby="resultModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header" id="resultModalHeader">
                    <h5 class="modal-title" id="resultModalLabel">Resultado</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body" id="resultModalBody"></div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                </div>
            </div>
        </div>
    </div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const mensaje = @Html.Raw(Json.Serialize(TempData["Resultado"]));
            const tipo = "@TempData["TipoMensaje"]";
            const redireccion = "@TempData["Redireccion"]";

            if (mensaje && mensaje.trim() !== "") {
                const resultModalBody = document.getElementById("resultModalBody");
                const resultModalTitle = document.getElementById("resultModalLabel");
                const resultModalHeader = document.getElementById("resultModalHeader");
                const resultModal = new bootstrap.Modal(document.getElementById("resultModal"));

                resultModalTitle.textContent = (tipo === "exito") ? "Éxito" : "Error";

                if (tipo === "exito") {
                    resultModalHeader.className = "modal-header bg-success text-white";
                } else {
                    resultModalHeader.className = "modal-header bg-danger text-white";
                }

                resultModalBody.textContent = mensaje;

                resultModal.show();

                document.getElementById("resultModal").addEventListener('hidden.bs.modal', function () {
                    if (tipo === "exito" && redireccion) {
                        window.location.href = `/ADM17_Notas/${redireccion}`;
                    }
                });
            }
        });
    </script>
}
